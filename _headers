# Response headers for the Cloudflare site (Workers static assets). GitHub Pages ignores this file.
# The page's own Content-Security-Policy is a <meta> tag in index.html; a header cannot set frame-ancestors from a meta tag,
# and when both exist the browser applies both.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
